#cloud-config
autoinstall:
  version: 1
  shutdown: poweroff
  identity:
    hostname: test-ubuntu
    username: ubuntu
    password: '$6$pQBjjcoCGHYvtUTS$3pBKrm7luA/wnUlM/C/5Ih8peWJ2J6MM.uZ9sDXR0iFzL4fI5PESXD.XW5Ql3.LO.VwaqwE3JhQBTINqaMuie/'  # 'pass' hashed

  refresh-installer:
    update: true
    channel: '25.04/candidate'     # not “stable”, used to overcome the swap file mount bug

  storage:
    bootloader:
      install_devices:
        - disk-system
      type: grub-efi
    config:
      - id: disk-system
        type: disk
        match:
          size: largest
        ptable: gpt
        wipe: superblock
        preserve: false
        name: system

      - id: part-efi
        type: partition
        device: disk-system
        size: 1G
        wipe: superblock
        flags: [boot, esp]
        grub_device: true

      - id: format-efi
        type: format
        volume: part-efi
        fstype: fat32
        label: efi

      - id: mount-efi
        device: format-efi
        path: /boot/efi
        type: mount
      - id: part-boot
        type: partition
        device: disk-system
        size: 1G
        wipe: superblock

      - id: format-boot
        type: format
        volume: part-boot
        fstype: ext4
        label: boot

      - id: luks-part
        type: partition
        device: disk-system
        size: -1
        wipe: superblock

      - id: luks-volume
        type: dm_crypt
        volume: luks-part
        key: pass

      - id: id_vg0
        name: vg0
        type: lvm_volgroup
        devices: [luks-volume]

      - id: lv_swap
        name: lv_swap
        type: lvm_partition
        volgroup: id_vg0
        size: 8G

      - id: format-swap
        fstype: swap
        volume: lv_swap
        type: format

      - id: lv_root
        name: ubuntu-lv
        volgroup: id_vg0
        type: lvm_partition
        size: -1

      - id: format-root
        fstype: ext4
        volume: lv_root
        type: format

      - id: mount-boot
        device: format-boot
        path: /boot
        type: mount

      - id: mount-root
        type: mount
        device: format-root
        path: /


  late-commands:
    # (A) Write a file *inside* the new root:
    - curtin in-target --target=/target -- bash -c 'echo test5 > /etc/test5.conf'
    # (B) Edit the target’s /etc/default/grub with sed:
    - curtin in-target --target=/target -- sed -i 's|^GRUB_CMDLINE_LINUX_DEFAULT=.*|GRUB_CMDLINE_LINUX_DEFAULT="console=ttyS0 earlyprintk=ttyS0 network-config=disabled"|g' /etc/default/grub
    # almost no timeout
    - curtin in-target --target=/target -- sed -i 's/^GRUB_TIMEOUT=.*/GRUB_TIMEOUT=1/' /etc/default/grub
    # (C) Then rebuild grub in the target:
    - curtin in-target --target=/target -- update-grub
    # Trying to prevent the 120s wait on first boot from systemd-networkd-wait-online
    # Mask the wait-online service to prevent it from delaying boot
    - curtin in-target --target=/target -- systemctl mask systemd-networkd-wait-online.service
    # Create a drop-in override to neutralize the wait-online behavior
    - curtin in-target --target=/target -- mkdir -p /etc/systemd/system/systemd-networkd-wait-online.service.d
    - curtin in-target --target=/target -- bash -c "echo -e '[Service]\nExecStart=\nExecStart=/lib/systemd/systemd-networkd-wait-online --any' > /etc/systemd/system/systemd-networkd-wait-online.service.d/override.conf"


  user-data:
    #cloud-config
    users:
      - name: ubuntu
        groups: users, admin
        sudo: ALL=(ALL) NOPASSWD:ALL
        passwd: $6$pQBjjcoCGHYvtUTS$3pBKrm7luA/wnUlM/C/5Ih8peWJ2J6MM.uZ9sDXR0iFzL4fI5PESXD.XW5Ql3.LO.VwaqwE3JhQBTINqaMuie/

    # packages:
    #   - ubuntu-desktop

    write_files:
      - path: /usr/local/bin/setup-hibernate.sh
        permissions: '0755'
        content: |
          #!/bin/bash
          set -eux

          install_custom_luks_prompt() {
            local keyscript_path="/lib/cryptsetup/scripts/custom-askpass-banner"
            local initramfs_hook_path="/etc/initramfs-tools/hooks/custom-askpass-banner"

            echo "[*] Installing custom cryptsetup keyscript..."
            cat > "$keyscript_path" <<'SCRIPT'
          #!/bin/sh
          if [ -c /dev/console ]; then
            exec 3>/dev/console
          else
            exec 3>&2
          fi

          cat >&3 <<'PROMPT'

          =============================================

          Hi there friend, thanks for finding my laptop !
          I would be most grateful if you could return it to me and
          would be delighted to furnish you with beer and food.
          Please contact me at the below

          email:xxx

          ==============================================

          PROMPT

          exec /lib/cryptsetup/askpass "Please unlock disk ${CRYPTTAB_NAME}: " 2>&3
          SCRIPT
            chmod 0755 "$keyscript_path"

            echo "[*] Installing initramfs hook for custom cryptsetup prompt..."
            cat > "$initramfs_hook_path" <<'HOOK'
          #!/bin/sh
          PREREQ="cryptroot"

          prereqs() {
            echo "$PREREQ"
          }

          case "$1" in
            prereqs)
              prereqs
              exit 0
              ;;
          esac

          . /usr/share/initramfs-tools/hook-functions

          copy_exec /lib/cryptsetup/scripts/custom-askpass-banner
          copy_exec /lib/cryptsetup/askpass
          HOOK
            chmod 0755 "$initramfs_hook_path"

            if grep -qE '^luks-volume[[:space:]]' /etc/crypttab; then
              awk -v keyscript="$keyscript_path" '
                BEGIN { OFS="\t" }
                $1 == "luks-volume" {
                  gsub(/(^|,)initramfs(,|$)/, ",", $4)
                  gsub(/,?keyscript=[^,[:space:]]+/, "", $4)
                  gsub(/,,+/, ",", $4)
                  gsub(/^,|,$/, "", $4)
                  if ($4 == "") {
                    $4 = "initramfs,keyscript=" keyscript
                  } else {
                    $4 = $4 ",initramfs,keyscript=" keyscript
                  }
                }
                { print }
              ' /etc/crypttab > /etc/crypttab.tmp
              mv /etc/crypttab.tmp /etc/crypttab
            else
              echo "ERROR: luks-volume entry missing from /etc/crypttab" >&2
              exit 1
            fi
          }

          echo "[*] Disabling network wait..."
          systemctl mask systemd-networkd-wait-online.service
          systemctl disable systemd-networkd-wait-online.service
          systemctl disable network-online.target


          echo "[*] Disabling systemd wait..."
          mkdir -p /etc/systemd/system/systemd-networkd-wait-online.service.d
          echo -e "[Service]\nExecStart=\nExecStart=/bin/true" > /etc/systemd/system/systemd-networkd-wait-online.service.d/override.conf

          systemctl daemon-reexec
          systemctl daemon-reload

          echo "setup the swap partition"
          mkswap /dev/mapper/vg0-lv_swap
          swapon /dev/mapper/vg0-lv_swap

          echo "[*] Configuring hibernate resume..."
          UUID=$(blkid -s UUID -o value /dev/mapper/vg0-lv_swap)
          echo "UUID=$UUID none swap sw 0 0" >> /etc/fstab
          echo "RESUME=UUID=$UUID" > /etc/initramfs-tools/conf.d/resume
          sed -i "s|^GRUB_CMDLINE_LINUX_DEFAULT=.*|GRUB_CMDLINE_LINUX_DEFAULT=\"console=ttyS0 earlyprintk=ttyS0 cloud-init=disabled resume=UUID=$UUID\"|" /etc/default/grub
          sed -i 's/^set GRUB_TIMEOUT=.*/set GRUB_TIMEOUT=1/' /etc/default/grub

          echo "[*] Configuring serial console..."
          grep -q "^GRUB_TERMINAL=" /etc/default/grub || echo 'GRUB_TERMINAL=serial' >> /etc/default/grub
          #grep -q "^GRUB_SERIAL_COMMAND=" /etc/default/grub || echo 'GRUB_SERIAL_COMMAND="serial --speed=115200 --unit=0 --word=8 --parity=no --stop=1"' >> /etc/default/grub
          systemctl enable serial-getty@ttyS0.service
          install_custom_luks_prompt

          echo "[*] Updating grub and initramfs..."
          update-grub
          update-initramfs -u
          grep -E '^luks-volume[[:space:]]' /etc/crypttab | grep -F 'initramfs'
          grep -E '^luks-volume[[:space:]]' /etc/crypttab | grep -F 'keyscript=/lib/cryptsetup/scripts/custom-askpass-banner'
          lsinitramfs "/boot/initrd.img-$(uname -r)" | grep -qxE '(usr/)?lib/cryptsetup/scripts/custom-askpass-banner'

          echo " GRUB ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++"
          logger -t grub -- "$(cat /etc/default/grub)"
          echo " GRUB ------------------------------------------------------------"

          echo "[*] Done — exiting early."
          exit 0

    runcmd:
      - bash /usr/local/bin/setup-hibernate.sh
      - bash -c "apt install -y linux-image-generic"
